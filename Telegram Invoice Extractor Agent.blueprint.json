            "version": 1,
            "parameters": {
                "__IMTCONN__": 10221855
            },
            "mapper": {
                "chatId": "{{1.message.chat.id}}",
                "text": "✅ INVOICE PROCESSED SUCCESSFULLY!\n\n🏢 Vendor: {{3.VendorName.valueString}}\n🧾 Invoice No: {{3.InvoiceId.valueString}}\n📅 Date: {{3.InvoiceDate.valueDate}}\n💵 Total Amount:{{3.InvoiceTotal.content}} \n\nRecorded in Google Sheets!",
