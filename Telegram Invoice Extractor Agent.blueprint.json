        {
            "id": 3,
            "module": "make-ai-extractors:extractAnInvoice",
            "version": 1,
            "parameters": {},
            "mapper": {
                "by": "file",
                "fileName": "{{2.fileName}}",
                "data": "{{2.fileOutput}}"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "by": {
                            "label": "File"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "by",
                        "type": "select",
                        "label": "Invoice source",
                        "required": true,
                        "validate": {
                            "enum": [
                                "file",
                                "url"
                            ]
                        }
                    },
                    {
                        "name": "fileName",
                        "type": "filename",
                        "label": "File name",
                        "required": true,
                        "extension": [
                            "pdf",
                            "jpeg",
                            "jpg",
                            "png",
                            "bmp",
                            "tiff",
                            "heif",
                            "docx",
                            "xlsx",
                            "pptx",
                            "html"
                        ]
                    },
                    {
                        "name": "data",
                        "type": "buffer",
                        "label": "Data",
                        "required": true
                    }
                ]
            }
        },
