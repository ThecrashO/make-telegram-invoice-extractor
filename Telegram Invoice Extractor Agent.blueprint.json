            "version": 1,
            "parameters": {
                "__IMTCONN__": 10221855
            },
            "mapper": {
                "fileId": "{{1.message.attachment.file_id}}"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "Invoice Extractor Agent",
                            "data": {
                                "scoped": "true",
                                "connection": "telegram"
